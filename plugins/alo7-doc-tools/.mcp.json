{
  "mcpServers": {
    "alo7-redmine": {
      "title": "ALO7 Redmine",
      "description": "Read and manage issues on redmine.saybot.net.",
      "command": "/bin/bash",
      "args": ["./scripts/redmine-mcp.sh", "-y", "@thelabnyc/redmine-mcp@0.5.0"],
      "cwd": ".",
      "env": {
        "REDMINE_URL": "https://redmine.saybot.net"
      },
      "env_vars": ["REDMINE_API_KEY"],
      "enabled_tools": [
        "get-issue",
        "list-issues",
        "search-redmine",
        "list-projects",
        "list-issue-statuses",
        "list-issue-priorities",
        "list-trackers",
        "whoami",
        "get-attachment",
        "download-attachment",
        "update-issue"
      ],
      "default_tools_approval_mode": "writes",
      "startup_timeout_sec": 30
    }
  }
}
